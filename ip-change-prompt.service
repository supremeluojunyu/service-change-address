[Unit]
Description=Boot-time console prompt to change local IP (netplan 50-cloud-init.yaml)
Documentation=file:///usr/local/share/ip-change-prompt/README.md
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
# 只拦 getty@tty1：提示结束后 getty 再起来，不要 Conflicts，否则会永久挡住登录
Before=getty@tty1.service network-pre.target
Wants=network-pre.target
ConditionPathExists=/etc/netplan/50-cloud-init.yaml
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
# 必须为 no：完成后释放，让 getty/登录界面正常启动
RemainAfterExit=no
ExecStart=/usr/local/sbin/ip-change-prompt.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=2
# 密码 30s + 首次改密约 60s + 改 IP 60s + 余量
TimeoutStartSec=180
User=root
Environment=IP_CHANGE_AUTH_TIMEOUT=30
Environment=IP_CHANGE_TIMEOUT=60
Environment=NETPLAN_FILE=/etc/netplan/50-cloud-init.yaml
Environment=IP_CHANGE_TTY=/dev/tty1
Environment=IP_CHANGE_CONFIG=/etc/ip-change-prompt.conf

[Install]
WantedBy=multi-user.target
